  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem;
  font-family: 'Montserrat', sans-serif !important;
  font-size: 18px !important;
  font-weight: 700;
  color: var(--gold);
}
.oc-timeline-point h4 {
  font-family: 'Montserrat', sans-serif !important;
