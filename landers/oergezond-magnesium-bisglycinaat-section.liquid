}
.oc-btn:hover {
  background: var(--terracotta-dark);
  transform: translateY(-2px);
  box-shadow: 0 15px 30px -10px rgba(196,113,74,0.5);
}
.oc-btn::after { content: '\2192'; font-size: 1.2rem; transition: transform 0.2s; }
.oc-btn:hover::after { transform: translateX(4px); }

.oc-cta-trust {
  margin-top: 1.5rem;
  font-size: 13px !important;
  opacity: 0.5;
  display: flex;
  justify-content: center;
  gap: 1.5rem;
  flex-wrap: wrap;
}


/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 900px) {
  .oc-natuur-grid { grid-template-columns: 1fr; }
  .oc-ingr-grid { grid-template-columns: 1fr; }
  .oc-werkt-grid { grid-template-columns: 1fr; gap: 2rem; }
  .oc-werkt-grid::before { display: none; }
  .oc-gebruik-grid { grid-template-columns: 1fr 1fr; }
  .oc-timeline-track { grid-template-columns: 1fr 1fr; }
  .oc-timeline-track::before { display: none; }
  .oc-proof-grid { grid-template-columns: 1fr; }
}
@media (max-width: 550px) {
  .oc-gebruik-grid { grid-template-columns: 1fr; }
  .oc-timeline-track { grid-template-columns: 1fr; }
  .oc-proof-summary { gap: 2rem; }
}
</style>


