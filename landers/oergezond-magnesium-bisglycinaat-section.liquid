  margin-top: 0.3rem;
}


/* ============================================================
   SECTION 7 — FAQ
   ============================================================ */
.oc-faq {
  background: #fff;
}
.oc-faq-list {
  max-width: 900px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.oc-faq-item {
  border-bottom: 1px solid rgba(44,24,16,0.08);
}
.oc-faq-q {
  width: 100%;
  background: none;
