{%- comment -%}
  Oergezond Magnesium Bisglycinaat — Custom Product Page Section
  Paste als Custom Liquid block in de product page template (onder de buy-box)
  Brand: Oergezond — Montserrat + Poppins, cream/forest/terracotta palette
  Formule: 2 ingredienten — magnesium bisglycinaat + plantaardige capsule (HPMC). 120 mg elementair magnesium per capsule.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
/* ============ RESET & SCOPING ============ */
.oc-custom *, .oc-custom *::before, .oc-custom *::after { margin: 0; padding: 0; box-sizing: border-box; }
.oc-custom img { max-width: 100%; display: block; }

/* ============ BRAND TOKENS ============ */
.oc-custom {
  --cream: #FAF6F0;
  --warm-white: #F5EFE3;
  --forest: #1A2E1A;
  --forest-dark: #0F1A0F;
  --terracotta: #C4714A;
  --terracotta-dark: #A55939;
  --dark: #2C1810;
  --sage: #A8B89A;
  --gold: #D4A574;
  --red-accent: #A63D2A;

  font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif !important;
  color: var(--dark);
  line-height: 1.7;
  font-size: 15px !important;
  overflow-x: hidden;

  /* Break out of Shopify container */
  width: 100vw;
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw !important;
  margin-right: -50vw !important;
}
.oc-custom h1, .oc-custom h2, .oc-custom h3, .oc-custom h4 {
  font-family: 'Montserrat', sans-serif !important;
  font-weight: 700 !important;
  color: var(--dark);
  line-height: 1.2;
  letter-spacing: -0.02em;
}
.oc-custom h2 { font-size: clamp(26px, 4.0vw, 38px) !important; }
.oc-custom h3 { font-size: clamp(18px, 2.4vw, 22px) !important; }

.oc-container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
.oc-section { padding: clamp(4rem, 10vw, 7rem) 0; }

.oc-eyebrow {
  font-family: 'Poppins', sans-serif !important;
  font-size: 12px !important;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--terracotta);
  margin-bottom: 1.2rem;
  display: inline-block;
}
.oc-accent { color: var(--terracotta); }
.oc-section-header {
  text-align: center;
  max-width: 800px;
  margin: 0 auto 4rem;
}
.oc-section-header p {
  font-size: 16px !important;
  opacity: 0.8;
  margin-top: 1.2rem;
  line-height: 1.7;
}


/* ============================================================
   SECTION 1 — PUURHEID WINT
   ============================================================ */
.oc-natuur {
  background: linear-gradient(135deg, var(--cream) 0%, var(--warm-white) 100%);
  position: relative;
}
.oc-natuur::before {
  content: '';
  position: absolute;
  top: -10%;
  right: -5%;
  width: 40%;
  height: 80%;
  background: radial-gradient(circle, rgba(196,113,74,0.06) 0%, transparent 60%);
  pointer-events: none;
}
.oc-natuur-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: stretch;
}
.oc-compare-card {
  border-radius: 1.2rem;
  padding: 2.5rem 2rem;
  position: relative;
  overflow: hidden;
}
.oc-compare-card--bad {
  background: #fff;
  border: 1px solid rgba(166,61,42,0.15);
}
.oc-compare-card--bad::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 4px;
  background: var(--red-accent);
}
.oc-compare-card--good {
  background: var(--forest);
  color: var(--cream);
  border: none;
}
.oc-compare-card--good::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 4px;
  background: var(--gold);
}
.oc-compare-card--good h3,
.oc-compare-card--good .oc-compare-label { color: var(--cream); }
.oc-compare-card--good .oc-compare-count { color: var(--gold); }

.oc-compare-label {
  font-family: 'Poppins', sans-serif !important;
  font-size: 11px !important;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  opacity: 0.6;
  margin-bottom: 0.5rem;
}
.oc-compare-card h3 { margin-bottom: 1.2rem; }
.oc-compare-count {
  font-family: 'Montserrat', sans-serif !important;
  font-size: 64px !important;
  font-weight: 900;
  font-style: italic;
  line-height: 1;
  margin-bottom: 0.5rem;
  color: var(--red-accent);
}
.oc-compare-count-label {
  font-size: 14px !important;
  font-weight: 600;
  opacity: 0.7;
  margin-bottom: 1.5rem;
}
.oc-ingredient-list {
  list-style: none;
  padding: 0;
  font-size: 14px !important;
  line-height: 2;
}
.oc-ingredient-list li { display: flex; align-items: flex-start; gap: 0.5rem; }
.oc-ingredient-list .x { color: var(--red-accent); font-weight: 700; flex-shrink: 0; }
.oc-ingredient-list .check { color: var(--gold); font-weight: 700; flex-shrink: 0; }

.oc-natuur-bottom {
  text-align: center;
  margin-top: 2.5rem;
  padding: 1.8rem 2.5rem;
  background: rgba(45,74,45,0.06);
  border-radius: 0.8rem;
  font-size: 16px !important;
  font-weight: 600;
}
.oc-natuur-bottom strong { color: var(--forest); }


/* ============================================================
   SECTION 2 — INGREDIËNTEN UITGELICHT
   ============================================================ */
.oc-ingredienten {
  background: #fff;
}
.oc-ingr-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2.5rem;
}
.oc-ingr-card {
  background: var(--cream);
  border-radius: 1.2rem;
  padding: 3rem 2.5rem;
  border: 1px solid rgba(44,24,16,0.06);
  position: relative;
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.oc-ingr-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 40px -15px rgba(44,24,16,0.12);
}
.oc-ingr-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 3px;
  background: var(--terracotta);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.4s;
}
.oc-ingr-card:hover::before { transform: scaleX(1); }

.oc-ingr-icon {
  width: 72px;
  height: 72px;
  background: var(--forest);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.2rem;
  margin-bottom: 1.5rem;
}
.oc-ingr-card h3 { margin-bottom: 0.75rem; }
.oc-ingr-card > p { font-size: 14px !important; opacity: 0.8; margin-bottom: 1.5rem; line-height: 1.7; }

.oc-ingr-facts {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}
.oc-ingr-facts li {
  font-size: 14px !important;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--forest);
}
.oc-ingr-facts li::before {
  content: '';
  width: 6px; height: 6px;
  background: var(--terracotta);
  border-radius: 50%;
  flex-shrink: 0;
}

.oc-ingr-bottom {
  margin-top: 3rem;
  text-align: center;
  font-size: 16px !important;
  opacity: 0.7;
  font-style: italic;
}


/* ============================================================
   SECTION 3 — TOEGESTANE CLAIMS
   ============================================================ */
.oc-werkt {
  background: var(--cream);
  position: relative;
}
.oc-werkt-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
  position: relative;
}
/* connector line between steps */
.oc-werkt-grid::before {
  content: '';
  position: absolute;
  top: 40px;
  left: calc(16.66% + 28px);
  right: calc(16.66% + 28px);
  height: 2px;
  background: linear-gradient(90deg, var(--terracotta), var(--forest), var(--gold));
  z-index: 0;
}
.oc-werkt-step {
  text-align: center;
  position: relative;
  z-index: 1;
}
.oc-werkt-num {
  width: 72px;
  height: 72px;
  background: var(--forest);
  color: var(--cream);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Montserrat', sans-serif !important;
  font-size: 30px !important;
  font-weight: 900;
  margin: 0 auto 1.5rem;
  box-shadow: 0 8px 20px -6px rgba(45,74,45,0.4);
}
.oc-werkt-step h3 { margin-bottom: 0.75rem; }
.oc-werkt-step p { font-size: 14px !important; opacity: 0.8; line-height: 1.7; max-width: 380px; margin: 0 auto; }
.oc-werkt-note {
  margin-top: 3rem;
  text-align: center;
  font-size: 13px !important;
  opacity: 0.6;
  font-style: italic;
  max-width: 760px;
  margin-left: auto;
  margin-right: auto;
}


/* ============================================================
   SECTION 4 — HOE JE HET GEBRUIKT
   ============================================================ */
.oc-gebruik {
  background: #fff;
}
.oc-gebruik-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
}
.oc-gebruik-stap {
  text-align: center;
  padding: 2.5rem 1.5rem;
  background: var(--cream);
  border-radius: 1rem;
  border: 1px solid rgba(44,24,16,0.06);
  transition: transform 0.3s ease;
}
.oc-gebruik-stap:hover { transform: translateY(-3px); }

.oc-gebruik-icon {
  font-size: 34px !important;
  margin-bottom: 1rem;
  display: block;
}
.oc-gebruik-stap h4 {
  font-family: 'Montserrat', sans-serif !important;
  font-size: 16px !important;
  font-weight: 700;
  margin-bottom: 0.6rem;
  color: var(--dark);
}
.oc-gebruik-stap p {
  font-size: 14px !important;
  opacity: 0.75;
  line-height: 1.7;
}


/* ============================================================
   SECTION 5 — WAAROM BISGLYCINAAT
   ============================================================ */
.oc-timeline {
  background: var(--forest);
  color: var(--cream);
  position: relative;
  overflow: hidden;
}
.oc-timeline::before {
  content: '';
  position: absolute;
  top: -30%; right: -10%;
  width: 50%; height: 120%;
  background: radial-gradient(circle, rgba(212,165,116,0.08) 0%, transparent 60%);
  pointer-events: none;
}
.oc-timeline .oc-section-header h2 { color: var(--cream); }
.oc-timeline .oc-section-header p { color: rgba(250,246,240,0.7); }
.oc-timeline .oc-eyebrow { color: var(--gold); }

.oc-timeline-track {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  position: relative;
}
/* timeline connector */
.oc-timeline-track::before {
  content: '';
  position: absolute;
  top: 36px;
  left: calc(12.5% + 24px);
  right: calc(12.5% + 24px);
  height: 2px;
  background: linear-gradient(90deg, var(--gold), var(--terracotta), var(--sage), var(--gold));
  opacity: 0.4;
}
.oc-timeline-point {
  text-align: center;
  position: relative;
  z-index: 1;
}
.oc-timeline-dot {
  width: 72px; height: 72px;
  background: transparent;
  border: 2px solid var(--gold);
  border-radius: 50% !important;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem;
  font-family: 'Montserrat', sans-serif !important;
  font-size: 26px !important;
  font-weight: 700;
  color: var(--gold);
}
.oc-timeline-point h4 {
  font-family: 'Montserrat', sans-serif !important;
  color: var(--cream);
  font-size: 19px !important;
  margin-bottom: 0.6rem;
}
.oc-timeline-point p {
  font-size: 14px !important;
  color: rgba(250,246,240,0.7);
  line-height: 1.7;
  max-width: 280px;
  margin: 0 auto;
}
.oc-totox-note {
  margin-top: 4rem;
  max-width: 820px;
  margin-left: auto;
  margin-right: auto;
  background: rgba(250,246,240,0.05);
  border: 1px solid rgba(212,165,116,0.25);
  border-radius: 1.2rem;
  padding: 2.5rem 2.5rem;
  position: relative;
  z-index: 1;
}
.oc-totox-note h3 {
  font-family: 'Montserrat', sans-serif !important;
  color: var(--gold) !important;
  font-size: 20px !important;
  margin-bottom: 1rem;
}
.oc-totox-note p {
  font-size: 14px !important;
  color: rgba(250,246,240,0.82);
  line-height: 1.8;
  margin-bottom: 1rem;
}
.oc-totox-note p:last-child { margin-bottom: 0; }
.oc-totox-note strong { color: var(--cream); font-weight: 700; }


/* ============================================================
   SECTION 6 — WAAROM KIEZEN
   ============================================================ */
.oc-proof {
  background: var(--cream);
}
.oc-proof-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}
.oc-proof-card {
  background: #fff;
  border-radius: 1.2rem;
  padding: 2.5rem;
  border: 1px solid rgba(44,24,16,0.06);
  display: flex;
  flex-direction: column;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.oc-proof-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 15px 30px -10px rgba(44,24,16,0.1);
}
.oc-proof-stars {
  color: var(--gold);
  font-size: 26px !important;
  letter-spacing: 0.1em;
  margin-bottom: 1rem;
}
.oc-proof-quote {
  font-size: 14px !important;
  line-height: 1.7;
  opacity: 0.85;
  flex: 1;
  margin-bottom: 1.2rem;
}
.oc-proof-author {
  font-size: 14px !important;
  font-weight: 700;
  color: var(--forest);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.oc-proof-badge {
  font-size: 10px !important;
  font-weight: 600;
