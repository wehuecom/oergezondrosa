  line-height: 1.7;
  opacity: 0.8;
}
.oc-faq-item.active .oc-faq-a {
  max-height: 400px;
  padding-bottom: 1.5rem;
}


/* ============================================================
   SECTION 8 — CTA
   ============================================================ */
.oc-cta {
  background: linear-gradient(135deg, var(--forest) 0%, var(--forest-dark) 100%);
  color: var(--cream);
  text-align: center;
  position: relative;
  overflow: hidden;
}
.oc-cta::before {
  content: '';
  position: absolute;
  top: -50%; left: -50%;
  width: 200%; height: 200%;
  background: radial-gradient(circle at 30% 70%, rgba(196,113,74,0.08) 0%, transparent 50%);
  pointer-events: none;
}
.oc-cta h2 { color: var(--cream); margin-bottom: 1rem; }
.oc-cta p { color: rgba(250,246,240,0.7); font-size: 16px !important; max-width: 700px; margin: 0 auto 2.5rem; }

.oc-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 1.3rem 3rem;
  background: var(--terracotta);
  color: #fff;
  font-family: 'Poppins', sans-serif !important;
  font-size: 14px !important;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  text-decoration: none;
