  margin-top: 2.5rem;
  padding: 1.8rem 2.5rem;
  background: rgba(45,74,45,0.06);
  border-radius: 0.8rem;
  font-size: 16px !important;
  font-weight: 600;
}
.oc-natuur-bottom strong { color: var(--forest); }


/* ============================================================
   SECTION 2 — INGREDIËNTEN UITGELICHT
   ============================================================ */
.oc-ingredienten {
