  width: 6px; height: 6px;
  background: var(--terracotta);
  border-radius: 50%;
  flex-shrink: 0;
}

.oc-ingr-bottom {
  margin-top: 3rem;
  text-align: center;
  font-size: 16px !important;
  opacity: 0.7;
  font-style: italic;
}


/* ============================================================
   SECTION 3 — WAT HET DOET
   ============================================================ */
.oc-werkt {
  background: var(--cream);
  position: relative;
}
.oc-werkt-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
  position: relative;
}
/* connector line between steps */
.oc-werkt-grid::before {
  content: '';
  position: absolute;
  top: 40px;
  left: calc(16.66% + 28px);
  right: calc(16.66% + 28px);
  height: 2px;
  background: linear-gradient(90deg, var(--terracotta), var(--forest), var(--gold));
  z-index: 0;
}
.oc-werkt-step {
  text-align: center;
  position: relative;
  z-index: 1;
}
.oc-werkt-num {
  width: 72px;
  height: 72px;
  background: var(--forest);
  color: var(--cream);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Montserrat', sans-serif !important;
  font-size: 30px !important;
  font-weight: 900;
  margin: 0 auto 1.5rem;
  box-shadow: 0 8px 20px -6px rgba(45,74,45,0.4);
}
.oc-werkt-step h3 { margin-bottom: 0.75rem; }
.oc-werkt-step p { font-size: 14px !important; opacity: 0.8; line-height: 1.7; max-width: 380px; margin: 0 auto; }
.oc-werkt-note {
  margin-top: 3rem;
  text-align: center;
  font-size: 13px !important;
  opacity: 0.6;
  font-style: italic;
  max-width: 760px;
  margin-left: auto;
  margin-right: auto;
}


/* ============================================================
   SECTION 4 — HOE JE HET GEBRUIKT
   ============================================================ */
.oc-gebruik {
  background: #fff;
}
.oc-gebruik-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
}
.oc-gebruik-stap {
  text-align: center;
  padding: 2.5rem 1.5rem;
  background: var(--cream);
  border-radius: 1rem;
  border: 1px solid rgba(44,24,16,0.06);
  transition: transform 0.3s ease;
}
.oc-gebruik-stap:hover { transform: translateY(-3px); }

.oc-gebruik-icon {
  font-size: 34px !important;
  margin-bottom: 1rem;
  display: block;
}
.oc-gebruik-stap h4 {
  font-family: 'Montserrat', sans-serif !important;
  font-size: 16px !important;
  font-weight: 700;
  margin-bottom: 0.6rem;
  color: var(--dark);
}
.oc-gebruik-stap p {
  font-size: 14px !important;
  opacity: 0.75;
  line-height: 1.7;
}


/* ============================================================
   SECTION 5 — 100% NATUURLIJK
   ============================================================ */
.oc-timeline {
  background: var(--forest);
  color: var(--cream);
  position: relative;
  overflow: hidden;
}
.oc-timeline::before {
  content: '';
  position: absolute;
  top: -30%; right: -10%;
  width: 50%; height: 120%;
  background: radial-gradient(circle, rgba(212,165,116,0.08) 0%, transparent 60%);
  pointer-events: none;
}
.oc-timeline .oc-section-header h2 { color: var(--cream); }
.oc-timeline .oc-section-header p { color: rgba(250,246,240,0.7); }
.oc-timeline .oc-eyebrow { color: var(--gold); }

.oc-timeline-track {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  position: relative;
}
/* timeline connector */
.oc-timeline-track::before {
  content: '';
  position: absolute;
  top: 36px;
  left: calc(12.5% + 24px);
  right: calc(12.5% + 24px);
  height: 2px;
  background: linear-gradient(90deg, var(--gold), var(--terracotta), var(--sage), var(--gold));
  opacity: 0.4;
}
.oc-timeline-point {
  text-align: center;
  position: relative;
  z-index: 1;
}
.oc-timeline-dot {
  width: 72px; height: 72px;
  background: transparent;
  border: 2px solid var(--gold);
  border-radius: 50% !important;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem;
  font-family: 'Montserrat', sans-serif !important;
  font-size: 26px !important;
  font-weight: 700;
  color: var(--gold);
}
.oc-timeline-point h4 {
  font-family: 'Montserrat', sans-serif !important;
  color: var(--cream);
  font-size: 19px !important;
  margin-bottom: 0.6rem;
}
.oc-timeline-point p {
  font-size: 14px !important;
  color: rgba(250,246,240,0.7);
  line-height: 1.7;
  max-width: 280px;
  margin: 0 auto;
}
.oc-totox-note {
  margin-top: 4rem;
  max-width: 820px;
  margin-left: auto;
  margin-right: auto;
  background: rgba(250,246,240,0.05);
  border: 1px solid rgba(212,165,116,0.25);
  border-radius: 1.2rem;
  padding: 2.5rem 2.5rem;
  position: relative;
  z-index: 1;
}
.oc-totox-note h3 {
  font-family: 'Montserrat', sans-serif !important;
  color: var(--gold) !important;
  font-size: 20px !important;
  margin-bottom: 1rem;
}
.oc-totox-note p {
  font-size: 14px !important;
  color: rgba(250,246,240,0.82);
  line-height: 1.8;
  margin-bottom: 1rem;
}
.oc-totox-note p:last-child { margin-bottom: 0; }
.oc-totox-note strong { color: var(--cream); font-weight: 700; }


/* ============================================================
   SECTION 6 — WAAROM KIEZEN
   ============================================================ */
.oc-proof {
  background: var(--cream);
}
.oc-proof-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}
.oc-proof-card {
  background: #fff;
  border-radius: 1.2rem;
  padding: 2.5rem;
  border: 1px solid rgba(44,24,16,0.06);
  display: flex;
  flex-direction: column;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.oc-proof-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 15px 30px -10px rgba(44,24,16,0.1);
}
.oc-proof-stars {
  color: var(--gold);
  font-size: 26px !important;
  letter-spacing: 0.1em;
  margin-bottom: 1rem;
}
.oc-proof-quote {
  font-size: 14px !important;
  line-height: 1.7;
  opacity: 0.85;
  flex: 1;
  margin-bottom: 1.2rem;
}
.oc-proof-author {
  font-size: 14px !important;
  font-weight: 700;
  color: var(--forest);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.oc-proof-badge {
  font-size: 10px !important;
  font-weight: 600;
  background: rgba(45,74,45,0.1);
  color: var(--forest);
