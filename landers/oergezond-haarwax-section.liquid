{%- comment -%}
  Oergezond Haarwax — Custom Product Page Section
  Paste als Custom Liquid block in de product page template (onder de buy-box)
  Brand: Oergezond — Montserrat + Poppins, cream/forest/terracotta palette
  100% natuurlijke haarwax. Ingredienten: bentoniet klei, castorolie, kokosolie, bijenwas, arrowroot. (geen percentages tonen)
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
/* ============ RESET & SCOPING ============ */
.oc-custom *, .oc-custom *::before, .oc-custom *::after { margin: 0; padding: 0; box-sizing: border-box; }
.oc-custom img { max-width: 100%; display: block; }

/* ============ BRAND TOKENS ============ */
.oc-custom {
  --cream: #FAF6F0;
  --warm-white: #F5EFE3;
  --forest: #1A2E1A;
  --forest-dark: #0F1A0F;
  --terracotta: #C4714A;
  --terracotta-dark: #A55939;
  --dark: #2C1810;
  --sage: #A8B89A;
  --gold: #D4A574;
  --red-accent: #A63D2A;

  font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif !important;
  color: var(--dark);
  line-height: 1.7;
  font-size: 15px !important;
  overflow-x: hidden;

  /* Break out of Shopify container */
  width: 100vw;
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw !important;
  margin-right: -50vw !important;
}
.oc-custom h1, .oc-custom h2, .oc-custom h3, .oc-custom h4 {
  font-family: 'Montserrat', sans-serif !important;
  font-weight: 700 !important;
  color: var(--dark);
  line-height: 1.2;
  letter-spacing: -0.02em;
}
.oc-custom h2 { font-size: clamp(26px, 4.0vw, 38px) !important; }
.oc-custom h3 { font-size: clamp(18px, 2.4vw, 22px) !important; }

.oc-container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
.oc-section { padding: clamp(4rem, 10vw, 7rem) 0; }

.oc-eyebrow {
  font-family: 'Poppins', sans-serif !important;
  font-size: 12px !important;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--terracotta);
  margin-bottom: 1.2rem;
  display: inline-block;
}
.oc-accent { color: var(--terracotta); }
.oc-section-header {
  text-align: center;
  max-width: 800px;
  margin: 0 auto 4rem;
}
.oc-section-header p {
  font-size: 16px !important;
  opacity: 0.8;
  margin-top: 1.2rem;
  line-height: 1.7;
}


/* ============================================================
   SECTION 1 — PUURHEID WINT
   ============================================================ */
.oc-natuur {
