}
.oc-ingredient-list li { display: flex; align-items: flex-start; gap: 0.5rem; }
.oc-ingredient-list .x { color: var(--red-accent); font-weight: 700; flex-shrink: 0; }
.oc-ingredient-list .check { color: var(--gold); font-weight: 700; flex-shrink: 0; }

.oc-natuur-bottom {
