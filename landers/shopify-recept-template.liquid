{% comment %}
  OERGEZOND RECEPTEN TEMPLATE
  ============================
  Plak dit in: Online Store > Themes > Customize > (maak template "page.recept") > Custom Liquid section

  Per recept maak je een nieuwe Shopify Page aan met template "recept".
  De pagina-titel wordt automatisch de receptnaam.
  De page content (wat je in de editor typt) wordt de intro-tekst.

  De rest (ingredienten, stappen, etc.) vul je in via de metafields hieronder,
  OF je past de hardcoded waardes aan in dit template.
{% endcomment %}

<style>
  /* Reset voor binnen Shopify */
  .oer-recept *, .oer-recept *::before, .oer-recept *::after { box-sizing: border-box; }
  .oer-recept { font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, sans-serif; color: #1a1a1a; line-height: 1.7; max-width: 100%; overflow-x: hidden; }

  /* HERO */
  .oer-recept .r-hero {
    background: linear-gradient(160deg, #2d3825 0%, #4b5a3c 100%);
    color: #fff;
    padding: 48px 24px 40px;
    text-align: center;
  }
  .oer-recept .r-hero-crumb { font-size: 13px; color: rgba(255,255,255,0.4); margin-bottom: 20px; }
  .oer-recept .r-hero-crumb a { color: rgba(255,255,255,0.55); text-decoration: none; }
  .oer-recept .r-hero-label {
    display: inline-block;
    background: rgba(168,192,144,0.2);
    color: #a8c090;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 20px;
    margin-bottom: 16px;
  }
  .oer-recept .r-hero h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(26px, 6vw, 42px);
    font-weight: 800;
    line-height: 1.2;
    margin: 0 auto 14px;
    max-width: 600px;
  }
  .oer-recept .r-hero-sub {
    font-size: clamp(15px, 3vw, 17px);
    color: rgba(255,255,255,0.6);
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .oer-recept .r-hero-meta {
    display: flex;
    justify-content: center;
    gap: 28px;
    margin-top: 28px;
    flex-wrap: wrap;
  }
  .oer-recept .r-meta-icon { font-size: 22px; margin-bottom: 2px; }
  .oer-recept .r-meta-val { font-weight: 700; font-size: 15px; color: #a8c090; }
  .oer-recept .r-meta-lbl { font-size: 10px; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 1px; }
  .oer-recept .r-meta-item { text-align: center; }

  /* IMAGE */
  .oer-recept .r-img {
    max-width: 720px;
    margin: -20px auto 0;
    padding: 0 24px;
    position: relative;
    z-index: 2;
  }
  .oer-recept .r-img img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    border-radius: 14px;
    box-shadow: 0 10px 36px rgba(0,0,0,0.12);
  }

  /* CONTENT WRAPPER */
  .oer-recept .r-content {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px 24px;
  }

  /* INTRO */
  .oer-recept .r-intro {
    font-size: 16px;
    color: #333;
    line-height: 1.85;
    margin-bottom: 36px;
    border-left: 3px solid #a8c090;
    padding-left: 20px;
  }

  /* PRINT */
  .oer-recept .r-print {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: 2px solid #e0ddd4;
    color: #666;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    margin-bottom: 24px;
  }
  .oer-recept .r-print:hover { border-color: #4b5a3c; color: #4b5a3c; }

  /* RECIPE CARD */
  .oer-recept .r-card {
    background: #f9f8f4;
    border-radius: 16px;
    padding: 36px;
    margin-bottom: 44px;
  }
  .oer-recept .r-card h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 26px;
    font-weight: 800;
    color: #2d3825;
    margin: 0 0 28px 0;
  }
  .oer-recept .r-cols {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 36px;
  }
  .oer-recept .r-card h3 {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #4b5a3c;
    margin: 0 0 14px 0;
    padding-bottom: 8px;
    border-bottom: 2px solid #e0ddd4;
  }

  /* INGREDIENTS */
  .oer-recept .r-ing { list-style: none; padding: 0; margin: 0; }
  .oer-recept .r-ing li {
    padding: 9px 0;
    border-bottom: 1px solid #e8e5dc;
    font-size: 14px;
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .oer-recept .r-ing li:last-child { border-bottom: none; }
  .oer-recept .r-ing-name { color: #333; }
  .oer-recept .r-ing-amt { font-weight: 700; color: #2d3825; white-space: nowrap; }

  /* STEPS */
  .oer-recept .r-steps { list-style: none; padding: 0; margin: 0; counter-reset: s; }
  .oer-recept .r-steps li {
    counter-increment: s;
    padding: 11px 0 11px 46px;
    position: relative;
    font-size: 14px;
    line-height: 1.7;
    border-bottom: 1px solid #e8e5dc;
  }
  .oer-recept .r-steps li:last-child { border-bottom: none; }
  .oer-recept .r-steps li::before {
    content: counter(s);
    position: absolute;
    left: 0; top: 11px;
    width: 30px; height: 30px;
    background: #4b5a3c;
    color: #fff;
    font-weight: 700;
    font-size: 13px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* TIP BOX */
  .oer-recept .r-tip {
    background: linear-gradient(135deg, #f0ebe0, #f5f2ea);
    border-radius: 10px;
    padding: 24px 28px;
    margin-top: 28px;
  }
  .oer-recept .r-tip h4 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 17px;
    color: #2d3825;
    margin: 0 0 10px 0;
  }
  .oer-recept .r-tip p { font-size: 13px; color: #555; line-height: 1.7; margin: 0; }

  /* ===== WEEKMENU CTA ===== */
  .oer-recept .r-cta {
    background: linear-gradient(160deg, #2d3825, #3a4a2e);
    border-radius: 20px;
    padding: 52px 36px;
    text-align: center;
    color: #fff;
    position: relative;
    overflow: hidden;
    margin-bottom: 44px;
  }
  .oer-recept .r-cta::before {
    content: '';
    position: absolute;
    top: -60px; right: -60px;
    width: 200px; height: 200px;
    background: rgba(168,192,144,0.08);
    border-radius: 50%;
  }
  .oer-recept .r-cta::after {
    content: '';
    position: absolute;
    bottom: -40px; left: -40px;
    width: 160px; height: 160px;
    background: rgba(168,192,144,0.06);
    border-radius: 50%;
  }
  .oer-recept .r-cta > * { position: relative; z-index: 1; }
  .oer-recept .r-cta-eye {
    display: inline-block;
    background: rgba(168,192,144,0.2);
    color: #a8c090;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 20px;
    margin-bottom: 18px;
  }
  .oer-recept .r-cta h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(22px, 5vw, 34px);
    font-weight: 800;
    line-height: 1.25;
    margin: 0 0 14px 0;
    color: #fff;
  }
  .oer-recept .r-cta h2 span { color: #a8c090; }
  .oer-recept .r-cta > p {
    font-size: 15px;
    color: rgba(255,255,255,0.65);
    max-width: 460px;
    margin: 0 auto;
    line-height: 1.7;
  }
  .oer-recept .r-cta-feats {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin: 22px 0 28px;
    flex-wrap: wrap;
  }
  .oer-recept .r-cta-feat {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: rgba(255,255,255,0.6);
  }
  .oer-recept .r-cta-chk {
    width: 20px; height: 20px;
    background: rgba(168,192,144,0.25);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: #a8c090;
  }
  .oer-recept .r-cta-btn {
    display: inline-block;
    background: #a8c090;
    color: #2d3825;
    font-weight: 700;
    font-size: 15px;
    padding: 14px 36px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s;
  }
  .oer-recept .r-cta-btn:hover { background: #bdd4a8; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.25); }
  .oer-recept .r-cta-price { margin-top: 14px; font-size: 12px; color: rgba(255,255,255,0.35); }

  /* ===== MORE RECIPES ===== */
  .oer-recept .r-more { margin-bottom: 44px; }
  .oer-recept .r-more h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 26px;
    font-weight: 800;
    color: #2d3825;
    margin: 0 0 20px 0;
  }
  .oer-recept .r-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .oer-recept .r-thumb {
    border-radius: 12px;
    overflow: hidden;
    background: #f9f8f4;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .oer-recept .r-thumb:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(0,0,0,0.1); }
  .oer-recept .r-thumb-img {
    width: 100%;
    height: 150px;
    object-fit: cover;
  }
  .oer-recept .r-thumb-body { padding: 14px; }
  .oer-recept .r-thumb-tag { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #4b5a3c; margin-bottom: 4px; }
  .oer-recept .r-thumb-title { font-family: 'Playfair Display', Georgia, serif; font-size: 15px; font-weight: 700; color: #2d3825; line-height: 1.3; }
  .oer-recept .r-thumb-meta { font-size: 12px; color: #999; margin-top: 6px; }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 640px) {
    .oer-recept .r-cols { grid-template-columns: 1fr; gap: 28px; }
    .oer-recept .r-card { padding: 24px 18px; }
    .oer-recept .r-grid { grid-template-columns: 1fr; }
    .oer-recept .r-hero-meta { gap: 16px; }
    .oer-recept .r-cta { padding: 36px 20px; }
    .oer-recept .r-cta-feats { flex-direction: column; align-items: center; }
    .oer-recept .r-img img { height: 240px; }
  }

  /* PRINT */
  @media print {
    .oer-recept .r-cta, .oer-recept .r-more, .oer-recept .r-print { display: none !important; }
    .oer-recept .r-hero { background: #fff !important; color: #1a1a1a !important; padding: 16px !important; }
    .oer-recept .r-hero h1 { color: #1a1a1a !important; }
    .oer-recept .r-hero-label { background: #eee !important; color: #333 !important; }
  }
</style>

<div class="oer-recept">

  <!-- ===== HERO ===== -->
  <section class="r-hero">
    <div class="r-hero-crumb">
      <a href="/">Oergezond</a> &rsaquo; <a href="/pages/recepten">Recepten</a> &rsaquo; {{ page.title }}
    </div>

    <!-- PAS AAN: categorie -->
    <div class="r-hero-label">Hoofdgerecht</div>

    <h1>{{ page.title }}</h1>

    <!-- PAS AAN: korte omschrijving -->
    <p class="r-hero-sub">Simpel, voedzaam en zonder troep. Zoals je overgrootmoeder het zou maken.</p>

    <div class="r-hero-meta">
      <!-- PAS AAN: bereidingstijd, porties, niveau -->
      <div class="r-meta-item">
        <div class="r-meta-icon">&#9201;</div>
        <div class="r-meta-val">35 min</div>
        <div class="r-meta-lbl">Bereidingstijd</div>
      </div>
      <div class="r-meta-item">
        <div class="r-meta-icon">&#127860;</div>
        <div class="r-meta-val">4</div>
        <div class="r-meta-lbl">Porties</div>
      </div>
      <div class="r-meta-item">
        <div class="r-meta-icon">&#9889;</div>
        <div class="r-meta-val">Makkelijk</div>
        <div class="r-meta-lbl">Niveau</div>
      </div>
    </div>
  </section>

  <!-- ===== RECIPE IMAGE ===== -->
  <!-- PAS AAN: vervang de image URL met je eigen foto -->
  <div class="r-img">
    <img src="https://placehold.co/720x380/e8e5dc/999999?text=Receptfoto" alt="{{ page.title }}">
  </div>

  <!-- ===== CONTENT ===== -->
  <div class="r-content">

    <!-- INTRO: dit komt uit de Shopify page editor -->
    {% if page.content != blank %}
      <div class="r-intro">{{ page.content }}</div>
    {% endif %}

    <button class="r-print" onclick="window.print()">&#128424; Print recept</button>

    <!-- ===== RECIPE CARD ===== -->
    <div class="r-card">
      <h2>Het recept</h2>
      <div class="r-cols">

        <!-- INGREDIENTEN — PAS AAN per recept -->
        <div>
          <h3>Ingredi&euml;nten</h3>
          <ul class="r-ing">
            <li><span class="r-ing-name">Grasgevoerd rundergehakt</span><span class="r-ing-amt">500 g</span></li>
            <li><span class="r-ing-name">Ei (scharrel of biologisch)</span><span class="r-ing-amt">1</span></li>
            <li><span class="r-ing-name">Knoflook, fijngehakt</span><span class="r-ing-amt">3 tenen</span></li>
            <li><span class="r-ing-name">Zeezout</span><span class="r-ing-amt">1 tl</span></li>
            <li><span class="r-ing-name">Zwarte peper</span><span class="r-ing-amt">naar smaak</span></li>
            <li><span class="r-ing-name">Gedroogde oregano</span><span class="r-ing-amt">1 tl</span></li>
            <li><span class="r-ing-name">Gepelde tomaten (blik)</span><span class="r-ing-amt">400 g</span></li>
            <li><span class="r-ing-name">Tomatenpuree</span><span class="r-ing-amt">2 el</span></li>
            <li><span class="r-ing-name">Ui, fijngesneden</span><span class="r-ing-amt">1 grote</span></li>
            <li><span class="r-ing-name">Olijfolie (extra vierge)</span><span class="r-ing-amt">2 el</span></li>
            <li><span class="r-ing-name">Verse basilicum</span><span class="r-ing-amt">handvol</span></li>
          </ul>
        </div>

        <!-- BEREIDING — PAS AAN per recept -->
        <div>
          <h3>Bereiding</h3>
          <ol class="r-steps">
            <li>Meng het gehakt met ei, 1 teen knoflook, zeezout, peper en oregano. Draai er balletjes van ter grootte van een walnoot.</li>
            <li>Verhit de olijfolie in een grote pan op middelhoog vuur. Bak de gehaktballetjes rondom goudbruin (5-6 min). Haal ze uit de pan en zet apart.</li>
            <li>Fruit de ui en resterende knoflook in dezelfde pan tot ze zacht zijn (3 min). Voeg de tomatenpuree toe en bak 1 minuut mee.</li>
            <li>Voeg de gepelde tomaten toe, breek ze met een lepel in stukken. Breng op smaak met zout en peper. Laat 5 minuten pruttelen.</li>
            <li>Leg de gehaktballetjes terug in de saus. Deksel erop, 15 minuten zachtjes laten sudderen op laag vuur.</li>
            <li>Serveer met verse basilicum. Lekker met bloemkoolrijst, zoete aardappel of gewoon puur.</li>
          </ol>

          <div class="r-tip">
            <h4>Oertip</h4>
            <p>Maak een dubbele portie en vries de helft in. Zo heb je altijd een snelle, gezonde maaltijd klaar zonder dat je naar bewerkte troep hoeft te grijpen.</p>
          </div>
        </div>

      </div>
    </div>

    <!-- ===== WEEKMENU CTA ===== -->
    <!-- PAS AAN: vervang de href="#" met de echte betaalpagina URL van het Oermenu -->
    <div class="r-cta">
      <div class="r-cta-eye">Oermenu</div>
      <h2>Elke week een compleet <span>weekmenu</span> zonder troep</h2>
      <p>Geen nadenken, geen etiketten lezen. Gewoon elke week 7 dagen aan recepten die je lichaam herkent. Boodschappenlijst inbegrepen.</p>
      <div class="r-cta-feats">
        <div class="r-cta-feat"><span class="r-cta-chk">&#10003;</span> 7 dagen compleet uitgewerkt</div>
        <div class="r-cta-feat"><span class="r-cta-chk">&#10003;</span> Boodschappenlijst erbij</div>
        <div class="r-cta-feat"><span class="r-cta-chk">&#10003;</span> 100% zonder zaadoli&euml;n</div>
      </div>
      <a href="#" class="r-cta-btn">Bekijk het Oermenu</a>
      <div class="r-cta-price">Vanaf &euro;9,95 per week &middot; direct toegang</div>
    </div>

    <!-- ===== MEER RECEPTEN ===== -->
    <!-- PAS AAN: links naar andere receptpagina's -->
    <div class="r-more">
      <h2>Meer recepten</h2>
      <div class="r-grid">
        <a href="#" class="r-thumb">
          <img class="r-thumb-img" src="https://placehold.co/300x150/e8e5dc/999999?text=Foto" alt="Recept">
          <div class="r-thumb-body">
            <div class="r-thumb-tag">Ontbijt</div>
            <div class="r-thumb-title">Oerpannenkoeken met blauwe bessen</div>
            <div class="r-thumb-meta">15 min &middot; 2 porties</div>
          </div>
        </a>
        <a href="#" class="r-thumb">
          <img class="r-thumb-img" src="https://placehold.co/300x150/e8e5dc/999999?text=Foto" alt="Recept">
          <div class="r-thumb-body">
            <div class="r-thumb-tag">Snack</div>
            <div class="r-thumb-title">Bone broth met kurkuma</div>
            <div class="r-thumb-meta">10 min &middot; 4 porties</div>
          </div>
        </a>
        <a href="#" class="r-thumb">
          <img class="r-thumb-img" src="https://placehold.co/300x150/e8e5dc/999999?text=Foto" alt="Recept">
          <div class="r-thumb-body">
            <div class="r-thumb-tag">Hoofdgerecht</div>
            <div class="r-thumb-title">Zalm met geroosterde groenten</div>
            <div class="r-thumb-meta">30 min &middot; 2 porties</div>
          </div>
        </a>
      </div>
    </div>

  </div>
</div>
