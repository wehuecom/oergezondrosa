   ============================================================ */
.oc-timeline {
  background: var(--forest);
  color: var(--cream);
  position: relative;
  overflow: hidden;
}
.oc-timeline::before {
  content: '';
  position: absolute;
  top: -30%; right: -10%;
  width: 50%; height: 120%;
  background: radial-gradient(circle, rgba(212,165,116,0.08) 0%, transparent 60%);
  pointer-events: none;
}
.oc-timeline .oc-section-header h2 { color: var(--cream); }
.oc-timeline .oc-section-header p { color: rgba(250,246,240,0.7); }
.oc-timeline .oc-eyebrow { color: var(--gold); }

.oc-timeline-track {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  position: relative;
}
/* timeline connector */
.oc-timeline-track::before {
  content: '';
  position: absolute;
  top: 36px;
  left: calc(12.5% + 24px);
  right: calc(12.5% + 24px);
  height: 2px;
  background: linear-gradient(90deg, var(--gold), var(--terracotta), var(--sage), var(--gold));
  opacity: 0.4;
}
.oc-timeline-point {
