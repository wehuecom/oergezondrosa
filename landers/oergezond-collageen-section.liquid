  border: 1px solid rgba(166,61,42,0.15);
}
.oc-compare-card--bad::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 4px;
  background: var(--red-accent);
}
.oc-compare-card--good {
  background: var(--forest);
  color: var(--cream);
  border: none;
}
.oc-compare-card--good::before {
