}
.oc-natuur-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: stretch;
}
.oc-compare-card {
  border-radius: 1.2rem;
  padding: 2.5rem 2rem;
  position: relative;
  overflow: hidden;
}
.oc-compare-card--bad {
  background: #fff;
  border: 1px solid rgba(166,61,42,0.15);
}
.oc-compare-card--bad::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 4px;
  background: var(--red-accent);
}
.oc-compare-card--good {
  background: var(--forest);
  color: var(--cream);
  border: none;
}
.oc-compare-card--good::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 4px;
  background: var(--gold);
}
.oc-compare-card--good h3,
