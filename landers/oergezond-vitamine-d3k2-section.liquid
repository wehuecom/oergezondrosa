/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 900px) {
  .oc-natuur-grid { grid-template-columns: 1fr; }
  .oc-ingr-grid { grid-template-columns: 1fr; }
  .oc-werkt-grid { grid-template-columns: 1fr; gap: 2rem; }
