/* ============================================================
   SECTION 5 — BESCHERMD / PUURHEID BEWAARD
   ============================================================ */
.oc-timeline {
  background: var(--forest);
  color: var(--cream);
  position: relative;
  overflow: hidden;
}
.oc-timeline::before {
  content: '';
  position: absolute;
  top: -30%; right: -10%;
  width: 50%; height: 120%;
  background: radial-gradient(circle, rgba(212,165,116,0.08) 0%, transparent 60%);
  pointer-events: none;
}
.oc-timeline .oc-section-header h2 { color: var(--cream); }
.oc-timeline .oc-section-header p { color: rgba(250,246,240,0.7); }
.oc-timeline .oc-eyebrow { color: var(--gold); }

.oc-timeline-track {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  position: relative;
}
/* timeline connector */
.oc-timeline-track::before {
  content: '';
  position: absolute;
  top: 36px;
  left: calc(12.5% + 24px);
  right: calc(12.5% + 24px);
  height: 2px;
  background: linear-gradient(90deg, var(--gold), var(--terracotta), var(--sage), var(--gold));
  opacity: 0.4;
}
.oc-timeline-point {
  text-align: center;
  position: relative;
  z-index: 1;
}
.oc-timeline-dot {
  width: 72px; height: 72px;
  background: transparent;
  border: 2px solid var(--gold);
  border-radius: 50% !important;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem;
  font-family: 'Montserrat', sans-serif !important;
  font-size: 26px !important;
  font-weight: 700;
  color: var(--gold);
}
.oc-timeline-point h4 {
  font-family: 'Montserrat', sans-serif !important;
  color: var(--cream);
  font-size: 19px !important;
  margin-bottom: 0.6rem;
}
.oc-timeline-point p {
  font-size: 14px !important;
  color: rgba(250,246,240,0.7);
  line-height: 1.7;
  max-width: 280px;
  margin: 0 auto;
}
.oc-totox-note {
  margin-top: 4rem;
  max-width: 820px;
  margin-left: auto;
  margin-right: auto;
  background: rgba(250,246,240,0.05);
  border: 1px solid rgba(212,165,116,0.25);
  border-radius: 1.2rem;
  padding: 2.5rem 2.5rem;
  position: relative;
  z-index: 1;
}
.oc-totox-note h3 {
  font-family: 'Montserrat', sans-serif !important;
  color: var(--gold) !important;
  font-size: 20px !important;
  margin-bottom: 1rem;
}
.oc-totox-note p {
  font-size: 14px !important;
  color: rgba(250,246,240,0.82);
  line-height: 1.8;
  margin-bottom: 1rem;
}
.oc-totox-note p:last-child { margin-bottom: 0; }
.oc-totox-note strong { color: var(--cream); font-weight: 700; }


/* ============================================================
   SECTION 6 — WAAROM KIEZEN
   ============================================================ */
.oc-proof {
  background: var(--cream);
}
.oc-proof-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
