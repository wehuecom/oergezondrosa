/* ============================================================
   SECTION 4 — HOE JE HET GEBRUIKT
   ============================================================ */
.oc-gebruik {
  background: #fff;
}
.oc-gebruik-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
}
.oc-gebruik-stap {
