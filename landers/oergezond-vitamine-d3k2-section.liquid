.oc-ingr-bottom {
  margin-top: 3rem;
  text-align: center;
  font-size: 16px !important;
  opacity: 0.7;
  font-style: italic;
}


/* ============================================================
   SECTION 3 — TOEGESTANE CLAIMS
   ============================================================ */
.oc-werkt {
  background: var(--cream);
  position: relative;
}
.oc-werkt-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
  position: relative;
}
/* connector line between steps */
.oc-werkt-grid::before {
  content: '';
