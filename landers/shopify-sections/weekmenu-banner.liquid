<style>
  .wm-wrap{max-width:720px;margin:0 auto;padding:0 24px 48px;font-family:-apple-system,BlinkMacSystemFont,sans-serif}
  .wm{background:linear-gradient(160deg,#1A2E1A,#243A24);border-radius:20px;padding:52px 36px;text-align:center;color:#fff;position:relative;overflow:hidden}
  .wm::before{content:'';position:absolute;top:-60px;right:-60px;width:200px;height:200px;background:rgba(168,192,144,0.08);border-radius:50%}
  .wm::after{content:'';position:absolute;bottom:-40px;left:-40px;width:160px;height:160px;background:rgba(168,192,144,0.06);border-radius:50%}
  .wm>*{position:relative;z-index:1}
  .wm-eye{display:inline-block;background:rgba(168,192,144,0.2);color:#a8c090;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:6px 16px;border-radius:20px;margin-bottom:18px}
  .wm h2{font-family:Georgia,serif;font-size:clamp(22px,5vw,34px);font-weight:800;line-height:1.25;margin:0 0 14px 0;color:#fff}
  .wm h2 span{color:#a8c090}
  .wm>p{font-size:15px;color:rgba(255,255,255,0.65);max-width:460px;margin:0 auto;line-height:1.7}
  .wm-feats{display:flex;justify-content:center;gap:20px;margin:22px 0 28px;flex-wrap:wrap}
  .wm-feat{display:flex;align-items:center;gap:7px;font-size:13px;color:rgba(255,255,255,0.6)}
  .wm-chk{width:20px;height:20px;background:rgba(168,192,144,0.25);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:11px;color:#a8c090}
  .wm-btn{display:inline-block;background:#a8c090;color:#1A2E1A;font-weight:700;font-size:15px;padding:14px 36px;border-radius:50px;text-decoration:none;transition:all 0.3s}
  .wm-btn:hover{background:#bdd4a8;transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,0.25);color:#1A2E1A}
  .wm-price{margin-top:14px;font-size:12px;color:rgba(255,255,255,0.35)}
  @media(max-width:640px){.wm{padding:36px 20px}.wm-feats{flex-direction:column;align-items:center}}
</style>

<div class="wm-wrap">
  <div class="wm">
    <div class="wm-eye">{{ section.settings.label }}</div>
    <h2>{{ section.settings.titel_voor }} <span>{{ section.settings.titel_groen }}</span></h2>
    <p>{{ section.settings.tekst }}</p>
    <div class="wm-feats">
      {% for block in section.blocks %}
        <div class="wm-feat"><span class="wm-chk">&#10003;</span> {{ block.settings.tekst }}</div>
      {% endfor %}
    </div>
    <a href="{{ section.settings.link }}" class="wm-btn">{{ section.settings.knop_tekst }}</a>
    {% if section.settings.prijs_tekst != blank %}
      <div class="wm-price">{{ section.settings.prijs_tekst }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Weekmenu Banner",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label bovenaan",
      "default": "Oermenu"
    },
    {
      "type": "text",
      "id": "titel_voor",
      "label": "Titel (wit deel)",
      "default": "Elke week een compleet"
    },
    {
      "type": "text",
      "id": "titel_groen",
      "label": "Titel (groen deel)",
      "default": "weekmenu zonder troep"
    },
    {
      "type": "textarea",
      "id": "tekst",
      "label": "Beschrijving",
      "default": "Geen nadenken, geen etiketten lezen. Gewoon elke week 7 dagen aan recepten die je lichaam herkent. Personaliseerbaar op jouw behoeftes en allergieen."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link naar betaalpagina"
    },
    {
      "type": "text",
      "id": "knop_tekst",
      "label": "Knoptekst",
      "default": "Bekijk het Oermenu"
    },
    {
      "type": "text",
      "id": "prijs_tekst",
      "label": "Prijstekst (optioneel)",
      "default": "Vanaf 7,95 per maand"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Voordeel",
      "settings": [
        {
          "type": "text",
          "id": "tekst",
          "label": "Voordeel",
          "default": "7 dagen compleet uitgewerkt"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Weekmenu Banner",
      "blocks": [
        { "type": "feature", "settings": { "tekst": "7 dagen compleet uitgewerkt" } },
        { "type": "feature", "settings": { "tekst": "Boodschappenlijst erbij" } },
        { "type": "feature", "settings": { "tekst": "100% zonder zaadolien" } },
        { "type": "feature", "settings": { "tekst": "Gepersonaliseerd op jouw allergieen" } }
      ]
    }
  ]
}
{% endschema %}
